# Sohbet uygulamasi systemd servisi.
# install.sh bu sablonu /etc/systemd/system/sohbet.service olarak yazar
# ({KULLANICI} ve {KOK} yerlerini doldurur).
[Unit]
Description=Sohbet uygulamasi (Node)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={KULLANICI}
Group={KULLANICI}
WorkingDirectory={KOK}/server
EnvironmentFile={KOK}/deploy/.env
ExecStart=/usr/bin/node --no-warnings {KOK}/server/src/index.js
Restart=always
RestartSec=3
LimitNOFILE=65536
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths={KOK}/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
