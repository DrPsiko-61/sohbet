{
	email __EMAIL__
	# Port 80 artik serbest (CasaOS kaldirildi): HTTP->HTTPS yonlendirmesi
	# ve Let's Encrypt HTTP-01 dogrulamasi yeniden acildi.
	servers {
		protocols h1 h2
	}
}

# ---------- Uygulama ----------
__APP_DOMAIN__ {
	tls {
		issuer acme {
		}
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	reverse_proxy 127.0.0.1:__APP_PORT__ {
		header_up X-Real-IP {remote_host}
		flush_interval -1
	}
}

# ---------- LiveKit (ses / video / ekran) ----------
__LIVE_DOMAIN__ {
	tls {
		issuer acme {
		}
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:7880 {
		header_up X-Real-IP {remote_host}
		flush_interval -1
	}
}

# ---------- LAN erisimi ----------
# Ev agindaki cihazlar icin. Router NAT dongusunu (hairpin) desteklemedigi icin
# LAN'dan public alan adina ulasilamiyor; cihazlar dogrudan sunucunun yerel
# adresine baglanir. Sertifika Caddy'nin yerel yetkilisinden alinir ve mobil
# uygulamaya tanitilir. LiveKit ayni adres uzerinden /livekit yolu ile sunulur.
https://__LAN_IP__ {
	tls {
		issuer internal {
		}
	}
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	handle_path /livekit/* {
		reverse_proxy 127.0.0.1:7880 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy 127.0.0.1:__APP_PORT__ {
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}
}
