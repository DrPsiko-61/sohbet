{
	email __EMAIL__
	# 80 portu CasaOS tarafindan kullanildigi icin HTTP yonlendirmesi ve HTTP-01 kapatildi.
	# Sertifika yalnizca 443 uzerinden TLS-ALPN-01 ile alinir.
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

# ---------- Uygulama ----------
__APP_DOMAIN__ {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	reverse_proxy 127.0.0.1:__APP_PORT__ {
		header_up X-Real-IP {remote_host}
		flush_interval -1
	}
}

# ---------- LiveKit (ses / video / ekran) ----------
__LIVE_DOMAIN__ {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:7880 {
		header_up X-Real-IP {remote_host}
		flush_interval -1
	}
}
