# Sunucuda (Linux) calisacak dosyalar her zaman LF satir sonu kullanmali.
# Windows'ta klonlayanlar icin de tutarli davranis saglar.
* text=auto eol=lf

*.sh    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Ikonlar ve medya ikili dosyalardir; donusturme yapilmaz.
*.png   binary
*.jpg   binary
*.webp  binary
*.svg   text eol=lf
*.ttf   binary
*.woff2 binary
