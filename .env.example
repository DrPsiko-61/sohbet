# ---- Sunucu ----
# Node uygulamasinin dinleyeceği port ve adres (Caddy arkasinda 127.0.0.1 kullanilir)
PORT=3300
HOST=127.0.0.1

# Veri ve web kok dizinleri (mutlak yol onerilir)
DATA_DIR=/opt/sohbet/data
WEB_DIR=/opt/sohbet/web

# HTTPS kullaniliyorsa true, yalnizca HTTP ise false
COOKIE_SECURE=true

# Davet kodu: ilk kullanici disindaki kayitlar bu kod olmadan yapilamaz.
# Bos birakilirsa davetsiz kayit tamamen kapanir. Rastgele bir deger verin.
INVITE_CODE=degistir-bunu

# Yuklenebilecek en buyuk dosya boyutu (bayt). Varsayilan 8 MB.
MAX_UPLOAD_BYTES=8388608

# ---- Ilk yonetici hesabi (yalnizca ilk kurulumda kullanilir) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ---- LiveKit (sesli/görüntülü gorusme) ----
# Anahtarlar LiveKit kurulumunda uretilir (bkz. KURULUM.md). Bos birakilirsa
# uygulama calisir ama sesli kanallar devre disi kalir.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Sunucudan LiveKit'e erisim (docker host aginda 127.0.0.1:7880)
LIVEKIT_HTTP_URL=http://127.0.0.1:7880
# Tarayiciya verilen genel adres. HTTPS varsa wss://alanadi.com, yoksa ws://IP:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
# Bot gibi sunucu tarafi baglantilar icin WS adresi (genelde ayni)
LIVEKIT_WS_URL=ws://127.0.0.1:7880

# GIF aramasi icin Giphy API anahtari (https://developers.giphy.com). Bos
# birakilirsa GIF paneli hazir populer GIF setini gosterir; anahtar tanimliyken
# canli arama calisir.
GIPHY_API_KEY=
